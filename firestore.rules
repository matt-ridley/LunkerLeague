rules_version = '2';
// Lunker League. Nothing is readable unless you are a signed-in, non-paused member of the league.
// config/league is created once by whoever sets up the league ("claiming" it); they become owner and admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function leaguePath() { return /databases/$(database)/documents/config/league; }
    function memberPath(id) { return /databases/$(database)/documents/members/$(id); }
    function league() { return get(leaguePath()).data; }
    function isMember() {
      return signedIn() && exists(memberPath(me())) && get(memberPath(me())).data.suspended != true;
    }
    function isAdmin() { return isMember() && me() in league().admins; }
    function isOwner() { return signedIn() && league().ownerUid == me(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function cleanName(n) { return n is string && n.size() > 0 && n.size() <= 40; }

    match /config/league {
      // Signed-in users can see whether a league exists (to show "Start" or "Join"); it holds no secrets.
      allow get: if signedIn();
      // Claiming: only while it doesn't exist, and only for yourself.
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.admins == [me()]
        && request.resource.data.keys().hasOnly(["name", "ownerUid", "admins", "createdAt"]);
      // Admins may rename it. Only the owner may change who the admins are, and the owner always stays an admin.
      allow update: if isAdmin()
        && !changed().hasAny(["ownerUid", "createdAt"])
        && (!changed().hasAny(["admins"]) || (isOwner() && resource.data.ownerUid in request.resource.data.admins));
    }

    match /config/invite {
      allow get: if isAdmin();
      // Created by the owner while claiming (same batch), then changed by admins.
      allow create: if signedIn() && getAfter(leaguePath()).data.ownerUid == me() && request.resource.data.code is string;
      allow update: if isAdmin() && request.resource.data.code is string && request.resource.data.code.size() >= 4;
    }

    match /members/{id} {
      allow get: if isMember() || (signedIn() && id == me());
      allow list: if isMember();
      allow create: if signedIn() && id == me()
        && cleanName(request.resource.data.displayName)
        && request.resource.data.suspended == false
        && (
          // The owner, while claiming the league.
          (getAfter(leaguePath()).data.ownerUid == me() && !request.resource.data.keys().hasAny(["invite"]))
          // Everyone else: the invite code must match.
          || (exists(/databases/$(database)/documents/config/invite)
              && request.resource.data.invite == get(/databases/$(database)/documents/config/invite).data.code)
        );
      // Your own profile, but you can't un-pause yourself or bring back an invite code.
      allow update: if (signedIn() && id == me() && !changed().hasAny(["suspended", "joinedAt"])
                         && !request.resource.data.keys().hasAny(["invite"])
                         && cleanName(request.resource.data.displayName))
        // Admins can pause or un-pause; only the owner can do that to another admin. Nobody can pause the owner.
        || (isAdmin() && changed().hasOnly(["suspended"]) && id != league().ownerUid
            && (!(id in league().admins) || isOwner()));
      allow delete: if isAdmin() && id != league().ownerUid && id != me() && (!(id in league().admins) || isOwner());
    }

    // ---------- Catches ----------
    // Times are epoch milliseconds from the phone. A catch can't be dated in the future (10 minutes' leeway for clocks).
    function catchPath(id) { return /databases/$(database)/documents/catches/$(id); }
    function optNum(d, f, max) { return !(f in d) || d[f] == null || (d[f] is number && d[f] > 0 && d[f] <= max); }
    function validCatch(d) {
      return d.keys().hasOnly(["uid", "species", "weightOz", "lengthIn", "caughtAt", "createdAt", "thumb", "photoTakenAt",
                               "notes", "released", "hasSpot", "locShared", "spotName",
                               "derbyId", "captain", "netman", "dq", "dqReason", "enteredBy"])
        && d.uid is string
        && d.species is string && d.species.size() > 0 && d.species.size() <= 40
        && optNum(d, "weightOz", 16000) && optNum(d, "lengthIn", 200)
        && (d.get("weightOz", null) != null || d.get("lengthIn", null) != null)
        && d.caughtAt is number && d.caughtAt <= request.time.toMillis() + 600000
        && d.createdAt is number
        && d.thumb is string && d.thumb.size() < 60000
        && (d.get("photoTakenAt", null) == null || d.photoTakenAt is number)
        && d.notes is string && d.notes.size() <= 500
        && d.released is bool && d.hasSpot is bool && d.locShared is bool
        && d.spotName is string && d.spotName.size() <= 60
        // A spot's name is only in the catch (where everyone can read it) when the spot is shared.
        && (d.locShared || d.spotName == "") && (d.hasSpot || !d.locShared)
        && validCrew(d.get("captain", null)) && validCrew(d.get("netman", null))
        && (d.get("derbyId", null) == null || derbyEntryOk(d));
    }
    // A boat crew member: a league member ({uid}) or a guest ({guest: "name"}).
    function validCrew(c) {
      return c == null || (c is map && c.keys().hasOnly(["uid", "guest"]) && c.keys().size() == 1
        && ((c.keys().hasAny(["uid"]) && c.uid is string) || (c.keys().hasAny(["guest"]) && c.guest is string
            && c.guest.size() > 0 && c.guest.size() <= 40)));
    }
    function derbyPath(id) { return /databases/$(database)/documents/derbies/$(id); }
    function entrantPath(id, who) { return /databases/$(database)/documents/derbies/$(id)/entrants/$(who); }
    function derbyOpen(dz) { return !dz.get("cancelled", false) && request.time.toMillis() <= dz.end + dz.syncGraceHours * 3600000; }
    // A derby entry: you joined, it was caught during the derby, it arrived before final entries closed (the grace
    // period lets catches from no-signal spots sync later), and it meets the derby's rules.
    function derbyEntryOk(d) {
      let dz = get(derbyPath(d.derbyId)).data;
      return exists(derbyPath(d.derbyId)) && exists(entrantPath(d.derbyId, d.uid)) && derbyOpen(dz)
        && d.caughtAt >= dz.start && d.caughtAt <= dz.end
        && (dz.species.size() == 0 || d.species in dz.species)
        && (!(dz.scoring in ["heaviest", "bag"]) || d.get("weightOz", null) != null)
        && (dz.scoring != "longest" || d.get("lengthIn", null) != null)
        && (dz.minWeightOz == 0 || (d.get("weightOz", null) != null && d.weightOz >= dz.minWeightOz))
        && (dz.minLengthIn == 0 || (d.get("lengthIn", null) != null && d.lengthIn >= dz.minLengthIn))
        && (!dz.catchRelease || d.released == true)
        && (!dz.requireLocation || d.locShared == true)
        && (!dz.requireCrew || (d.get("captain", null) != null && d.get("netman", null) != null));
    }
    // The derby a catch was entered in (if any), and whether I organise it.
    function derbyOf(c) { return get(derbyPath(c.derbyId)).data; }
    function isOrganiserOf(c) { return c.get("derbyId", null) != null && exists(derbyPath(c.derbyId)) && derbyOf(c).organiserUid == me(); }
    // A testing derby's organiser can clear out everything entered in it.
    function testingOrganiserOf(c) { return isOrganiserOf(c) && derbyOf(c).get("testing", false) == true; }
    // A catch is written by its angler, or by a derby's organiser entering it for an angler (enteredBy = organiser).
    function writesFor(d) {
      return (d.uid == me() && d.get("enteredBy", null) == null)
        || (d.get("enteredBy", null) == me() && d.uid != me() && isOrganiserOf(d) && exists(memberPath(d.uid)));
    }
    function sameDq(a, b) { return a.get("dq", false) == b.get("dq", false) && a.get("dqReason", "") == b.get("dqReason", ""); }
    match /catches/{id} {
      allow read: if isMember();
      allow create: if isMember() && validCatch(request.resource.data) && writesFor(request.resource.data)
        && request.resource.data.get("dq", false) == false
        && !request.resource.data.keys().hasAny(["dqReason"]);
      // The angler can edit their catch, but can't touch a disqualification, and a derby entry is locked once
      // that derby's final entries have closed.
      // An organiser who entered a catch for an angler can edit it too. A deleted derby no longer locks its old entries.
      allow update: if (isMember()
          && (resource.data.uid == me() || (resource.data.get("enteredBy", null) == me() && isOrganiserOf(resource.data)))
          && validCatch(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.get("enteredBy", null) == resource.data.get("enteredBy", null)
          && request.resource.data.createdAt == resource.data.createdAt
          && sameDq(request.resource.data, resource.data)
          && (resource.data.get("derbyId", null) == null || !exists(derbyPath(resource.data.derbyId))
              || derbyOpen(get(derbyPath(resource.data.derbyId)).data)))
        // The derby's organiser (or an admin) can disqualify or reinstate an entry, and change nothing else.
        || (isMember() && resource.data.get("derbyId", null) != null
            && (get(derbyPath(resource.data.derbyId)).data.organiserUid == me() || isAdmin())
            && changed().hasOnly(["dq", "dqReason"])
            && request.resource.data.dq is bool
            && request.resource.data.get("dqReason", "") is string && request.resource.data.get("dqReason", "").size() <= 200);
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin()
        || resource.data.get("enteredBy", null) == me() || testingOrganiserOf(resource.data));

      // The catch's angler (or a testing derby's organiser clearing it out) can remove its comments and reactions.
      function catchOwner() { let c = get(catchPath(id)).data; return c.uid == me() || testingOrganiserOf(c); }

      // Comments: anyone in the league, as themselves. The author, the catch's angler or an admin can remove one.
      match /comments/{cid} {
        allow create: if isMember() && exists(catchPath(id))
          && request.resource.data.keys().hasOnly(["uid", "text", "at"])
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 600000;
        allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || catchOwner());
      }

      // Emoji reactions: one doc per person per catch, named by their user id, so nobody can change anyone else's.
      match /reactions/{rid} {
        allow create, update: if isMember() && rid == me() && exists(catchPath(id))
          && request.resource.data.keys().hasOnly(["uid", "emojis", "at"])
          && request.resource.data.uid == me()
          && request.resource.data.emojis is list && request.resource.data.emojis.size() > 0 && request.resource.data.emojis.size() <= 8
          && request.resource.data.at is number;
        allow delete: if isMember() && (rid == me() || isAdmin() || catchOwner());
      }
    }

    // Reading comments and reactions across all catches at once (the app keeps them all, like the catches).
    match /{path=**}/comments/{cid} { allow read: if isMember(); }
    match /{path=**}/reactions/{rid} { allow read: if isMember(); }

    // League chat.
    match /chat/{mid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(["uid", "text", "at"])
        && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 600000;
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin());
    }

    // The full-size photo of a catch, in its own doc so lists only load thumbnails. Same id as the catch.
    match /photos/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && request.resource.data.keys().hasOnly(["uid", "src"])
        && request.resource.data.uid == me() && request.resource.data.src is string
        && request.resource.data.src.size() < 700000
        && (getAfter(catchPath(id)).data.uid == me() || getAfter(catchPath(id)).data.get("enteredBy", null) == me());
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || testingOrganiserOf(get(catchPath(id)).data));
    }

    // GPS spot of a catch. Kept out of the catch so a private spot is only ever readable by its owner.
    match /spots/{id} {
      allow read: if isMember() && (resource.data.shared == true || resource.data.uid == me());
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(["uid", "lat", "lng", "acc", "name", "shared"])
        && request.resource.data.uid == me()
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.acc is number
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.shared is bool
        // Must match its catch, so the catch never says "shared" while the spot is private or the other way round.
        // A spot an organiser tags for someone else's entry must be shared, so the angler can see it too.
        && (getAfter(catchPath(id)).data.uid == me()
            || (getAfter(catchPath(id)).data.get("enteredBy", null) == me() && request.resource.data.shared == true))
        && getAfter(catchPath(id)).data.locShared == request.resource.data.shared;
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || testingOrganiserOf(get(catchPath(id)).data));
    }

    // ---------- Derbies ----------
    function validDerby(d) {
      return d.keys().hasOnly(["name", "description", "organiserUid", "start", "end", "syncGraceHours", "species", "scoring",
                               "bagSize", "minWeightOz", "minLengthIn", "maxEntries", "proof", "requireLocation", "catchRelease",
                               "requireCrew", "prizeNote", "cancelled", "createdAt",
                               "entryFee", "addedMoney", "payoutPcts", "unpaidCanWin", "captainPct", "netmanPct", "roundTo", "sidePotFee",
                               "testing"])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.description is string && d.description.size() <= 500
        && d.start is number && d.end is number && d.end > d.start
        && d.syncGraceHours is number && d.syncGraceHours >= 0 && d.syncGraceHours <= 168
        && d.species is list && d.species.size() <= 40
        && d.scoring in ["heaviest", "longest", "bag", "most", "species"]
        && d.bagSize is number && d.bagSize >= 1 && d.bagSize <= 20
        && d.minWeightOz is number && d.minWeightOz >= 0 && d.minLengthIn is number && d.minLengthIn >= 0
        && d.maxEntries is number && d.maxEntries >= 0 && d.maxEntries <= 100
        && d.proof in ["any", "scale", "board", "both"]
        && d.requireLocation is bool && d.catchRelease is bool && d.requireCrew is bool
        && d.prizeNote is string && d.prizeNote.size() <= 300
        && d.cancelled is bool && d.createdAt is number
        && d.get("testing", false) is bool
        && validMoney(d);
    }
    // Entry fees and payouts (the app only keeps track; nobody pays through it). Older derbies have none of these.
    function money(d, f) { return d.get(f, 0); }
    function validMoney(d) {
      return money(d, "entryFee") is number && money(d, "entryFee") >= 0 && money(d, "entryFee") <= 10000
        && money(d, "addedMoney") is number && money(d, "addedMoney") >= 0 && money(d, "addedMoney") <= 100000
        && money(d, "sidePotFee") is number && money(d, "sidePotFee") >= 0 && money(d, "sidePotFee") <= 10000
        && money(d, "captainPct") is number && money(d, "captainPct") >= 0 && money(d, "captainPct") <= 50
        && money(d, "netmanPct") is number && money(d, "netmanPct") >= 0 && money(d, "netmanPct") <= 50
        && money(d, "roundTo") in [0, 1, 5]
        && d.get("payoutPcts", []) is list && d.get("payoutPcts", []).size() <= 10
        && d.get("unpaidCanWin", false) is bool;
    }
    match /derbies/{did} {
      allow read: if isMember();
      allow create: if isMember() && validDerby(request.resource.data) && request.resource.data.organiserUid == me()
        && request.resource.data.cancelled == false;
      // The organiser or an admin can change it (cancel it, or end it early). Only the league owner can change
      // whether it's a testing derby, so a real derby can't be turned into a deletable one.
      allow update: if isMember() && (resource.data.organiserUid == me() || isAdmin())
        && validDerby(request.resource.data) && !changed().hasAny(["organiserUid", "createdAt"])
        && (!changed().hasAny(["testing"]) || isOwner());
      // Deleting: the league owner, any derby; its organiser, only a testing derby. Real results otherwise stay.
      allow delete: if isMember() && (isOwner() || (resource.data.organiserUid == me() && resource.data.get("testing", false) == true));

      // Joining: yourself, until the derby ends. Leaving: yourself, or removed by the organiser or an admin.
      match /entrants/{who} {
        allow create: if isMember() && who == me() && request.resource.data.keys().hasOnly(["joinedAt"])
          && request.resource.data.joinedAt is number
          && !get(derbyPath(did)).data.cancelled && request.time.toMillis() <= get(derbyPath(did)).data.end;
        allow delete: if isMember() && (who == me() || get(derbyPath(did)).data.organiserUid == me() || isAdmin());
        // Paid ticks: only the organiser or an admin, and nothing else about the entrant.
        allow update: if isMember() && (get(derbyPath(did)).data.organiserUid == me() || isAdmin())
          && changed().hasOnly(["paid", "paidAt", "paidMarkedBy", "sidePotPaid"])
          && request.resource.data.get("paid", false) is bool && request.resource.data.get("sidePotPaid", false) is bool
          && request.resource.data.get("paidMarkedBy", me()) == me();
      }

      // "Paid out" ticks for each payee once the organiser has settled up.
      match /settlements/{key} {
        allow read: if isMember();
        allow create, update: if isMember() && (get(derbyPath(did)).data.organiserUid == me() || isAdmin())
          && request.resource.data.keys().hasOnly(["amount", "settledAt", "by"])
          && request.resource.data.amount is number && request.resource.data.settledAt is number
          && request.resource.data.by == me();
        allow delete: if isMember() && (get(derbyPath(did)).data.organiserUid == me() || isAdmin());
      }

      // Derby chat (trash talk for this derby).
      match /chat/{mid} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(["uid", "text", "at"])
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 600000;
        allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || get(derbyPath(did)).data.organiserUid == me());
      }
    }
    match /{path=**}/entrants/{who} { allow read: if isMember(); }

    // ---------- Ranking points ----------
    // Each change to the scoring values is a new version; old versions are never edited or deleted, so the
    // history of how points worked can't be rewritten. Points themselves are never stored.
    function pts(n) { return n is number && n >= 0 && n <= 1000; }
    function validScoring(v) {
      return v.keys().hasOnly(["catchPts", "dailyCap", "speciesPts", "recordPts", "derbyPts", "participationPts", "beatPts", "titles"])
        && pts(v.catchPts) && pts(v.dailyCap) && pts(v.speciesPts) && pts(v.participationPts) && pts(v.beatPts)
        && v.recordPts is list && v.recordPts.size() == 3
        && v.derbyPts is list && v.derbyPts.size() == 3
        && v.titles is list && v.titles.size() == 7;
    }
    match /scoring/{vid} {
      allow read: if isMember();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["mode", "effectiveFrom", "createdAt", "createdBy", "note", "values"])
        && request.resource.data.mode in ["retro", "forward"]
        && request.resource.data.effectiveFrom is number && request.resource.data.createdAt is number
        && request.resource.data.createdBy == me()
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && validScoring(request.resource.data.values);
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
