rules_version = '2';
// Lunker League. Nothing is readable unless you are a signed-in, non-paused member of the league.
// config/league is created once by whoever sets up the league ("claiming" it); they become owner and admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function leaguePath() { return /databases/$(database)/documents/config/league; }
    function memberPath(id) { return /databases/$(database)/documents/members/$(id); }
    function league() { return get(leaguePath()).data; }
    function isMember() {
      return signedIn() && exists(memberPath(me())) && get(memberPath(me())).data.suspended != true;
    }
    function isAdmin() { return isMember() && me() in league().admins; }
    function isOwner() { return signedIn() && league().ownerUid == me(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function cleanName(n) { return n is string && n.size() > 0 && n.size() <= 40; }

    match /config/league {
      // Signed-in users can see whether a league exists (to show "Start" or "Join"); it holds no secrets.
      allow get: if signedIn();
      // Claiming: only while it doesn't exist, and only for yourself.
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.admins == [me()]
        && request.resource.data.keys().hasOnly(["name", "ownerUid", "admins", "createdAt"]);
      // Admins may rename it. Only the owner may change who the admins are, and the owner always stays an admin.
      allow update: if isAdmin()
        && !changed().hasAny(["ownerUid", "createdAt"])
        && (!changed().hasAny(["admins"]) || (isOwner() && resource.data.ownerUid in request.resource.data.admins))
        // Days a catch can be logged late and still count (older ones are past catches).
        && (!("graceDays" in request.resource.data) || (request.resource.data.graceDays is int
            && request.resource.data.graceDays >= 0 && request.resource.data.graceDays <= 60))
        // The league start (catches before it are past catches). Admins can move it, but not into the future.
        && (!("startAt" in request.resource.data) || (request.resource.data.startAt is int
            && request.resource.data.startAt <= request.time.toMillis() + 600000));
    }

    match /config/invite {
      allow get: if isAdmin();
      // Created by the owner while claiming (same batch), then changed by admins.
      allow create: if signedIn() && getAfter(leaguePath()).data.ownerUid == me() && request.resource.data.code is string;
      allow update: if isAdmin() && request.resource.data.code is string && request.resource.data.code.size() >= 4;
    }

    match /members/{id} {
      allow get: if isMember() || (signedIn() && id == me());
      allow list: if isMember();
      allow create: if signedIn() && id == me()
        && cleanName(request.resource.data.displayName)
        && request.resource.data.suspended == false
        && (
          // The owner, while claiming the league.
          (getAfter(leaguePath()).data.ownerUid == me() && !request.resource.data.keys().hasAny(["invite"]))
          // Everyone else: the invite code must match.
          || (exists(/databases/$(database)/documents/config/invite)
              && request.resource.data.invite == get(/databases/$(database)/documents/config/invite).data.code)
        );
      // Your own profile, but you can't un-pause yourself or bring back an invite code.
      allow update: if (signedIn() && id == me() && !changed().hasAny(["suspended", "joinedAt"])
                         && !request.resource.data.keys().hasAny(["invite"])
                         && cleanName(request.resource.data.displayName))
        // Admins can pause or un-pause; only the owner can do that to another admin. Nobody can pause the owner.
        || (isAdmin() && changed().hasOnly(["suspended"]) && id != league().ownerUid
            && (!(id in league().admins) || isOwner()));
      allow delete: if isAdmin() && id != league().ownerUid && id != me() && (!(id in league().admins) || isOwner());
    }

    // ---------- Catches ----------
    // Times are epoch milliseconds from the phone. A catch can't be dated in the future (10 minutes' leeway for clocks).
    function catchPath(id) { return /databases/$(database)/documents/catches/$(id); }
    function optNum(d, f, max) { return !(f in d) || d[f] == null || (d[f] is number && d[f] > 0 && d[f] <= max); }
    function validCatch(d) {
      return d.keys().hasOnly(["uid", "species", "weightOz", "lengthIn", "caughtAt", "createdAt", "thumb", "photoTakenAt",
                               "notes", "released", "hasSpot", "locShared", "spotName",
                               "derbyId", "captain", "netman", "dq", "dqReason", "enteredBy", "fishCount", "limit", "past",
                               "approved", "approvedAt", "hasTackle", "tackleShared"])
        && (!("past" in d) || d.past is bool)
        && d.get("approved", false) is bool && (d.get("approvedAt", null) == null || d.approvedAt is number)
        && d.uid is string
        && d.species is string && d.species.size() > 0 && d.species.size() <= 40
        && optNum(d, "weightOz", 16000) && optNum(d, "lengthIn", 200)
        && d.caughtAt is number && d.caughtAt <= request.time.toMillis() + 600000
        && d.createdAt is number
        && d.thumb is string && d.thumb.size() > 100 && d.thumb.size() < 60000
        && (d.get("photoTakenAt", null) == null || d.photoTakenAt is number)
        && d.notes is string && d.notes.size() <= 500
        && d.released is bool && d.hasSpot is bool && d.locShared is bool
        && d.spotName is string && d.spotName.size() <= 60
        // A spot's name is only in the catch (where everyone can read it) when the spot is shared.
        && (d.locShared || d.spotName == "") && (d.hasSpot || !d.locShared)
        // Tackle lives in its own doc (it can be secret); the catch only says whether there is some and if it's shared.
        && d.get("hasTackle", false) is bool && d.get("tackleShared", false) is bool
        && (d.get("hasTackle", false) || !d.get("tackleShared", false))
        && validCrew(d.get("captain", null)) && validCrew(d.get("netman", null))
        && (d.get("fishCount", null) == null ? d.get("limit", null) == null : validStringer(d))
        && (d.get("derbyId", null) == null || derbyEntryOk(d));
    }
    // A past catch (logbook) earns no points, badges or crowns. Two reasons:
    // - Logged more than the grace days after it was caught (createdAt is when it was entered on the phone, even
    //   with no signal). Saved on the catch as past: true, required when it applies, and never taken off.
    // - Caught before the league start. The app works this out from the start date (admins can move it), so it
    //   isn't required on the catch; it's allowed though (older versions of the app saved it).
    function leagueStart() { return league().get("startAt", league().createdAt); }
    function loggedLate(d) { return d.caughtAt < d.createdAt - league().get("graceDays", 7) * 86400000; }
    function pastOk(d, wasPast) {
      return d.get("past", false) == (wasPast || loggedLate(d)) || (d.get("past", false) == true && d.caughtAt < leagueStart());
    }
    // A stringer: one photo of 2 to 500 fish, said to be a limit or not. Never measured, never released.
    function validStringer(d) {
      return d.fishCount is int && d.fishCount >= 2 && d.fishCount <= 500
        && d.get("limit", null) is bool
        && d.get("weightOz", null) == null && d.get("lengthIn", null) == null
        && d.released == false;
    }
    // A boat crew member: a league member ({uid}) or a guest ({guest: "name"}).
    function validCrew(c) {
      return c == null || (c is map && c.keys().hasOnly(["uid", "guest"]) && c.keys().size() == 1
        && ((c.keys().hasAny(["uid"]) && c.uid is string) || (c.keys().hasAny(["guest"]) && c.guest is string
            && c.guest.size() > 0 && c.guest.size() <= 40)));
    }
    function derbyPath(id) { return /databases/$(database)/documents/derbies/$(id); }
    function entrantPath(id, who) { return /databases/$(database)/documents/derbies/$(id)/entrants/$(who); }
    function derbyOpen(dz) { return !dz.get("cancelled", false) && request.time.toMillis() <= dz.end + dz.syncGraceHours * 3600000; }
    // A derby entry: you joined, it was caught during the derby, it arrived before final entries closed (the grace
    // period lets catches from no-signal spots sync later), and it meets the derby's rules.
    function derbyEntryOk(d) {
      let dz = get(derbyPath(d.derbyId)).data;
      return d.get("fishCount", null) == null // a stringer is never a derby entry
        && d.get("past", false) == false
        && exists(derbyPath(d.derbyId)) && exists(entrantPath(d.derbyId, d.uid)) && derbyOpen(dz)
        && d.caughtAt >= dz.start && d.caughtAt <= dz.end
        && (dz.species.size() == 0 || d.species in dz.species)
        // With categories, a fish only needs what one of them needs (the app checks that), so not here.
        && (dz.get("categories", []).size() > 0 || !(dz.scoring in ["heaviest", "bag"]) || d.get("weightOz", null) != null)
        && (dz.get("categories", []).size() > 0 || dz.scoring != "longest" || d.get("lengthIn", null) != null)
        && (dz.minWeightOz == 0 || (d.get("weightOz", null) != null && d.weightOz >= dz.minWeightOz))
        && (dz.minLengthIn == 0 || (d.get("lengthIn", null) != null && d.lengthIn >= dz.minLengthIn))
        && (!dz.catchRelease || d.released == true)
        && (!dz.requireLocation || d.locShared == true)
        && (!dz.requireCrew || (d.get("captain", null) != null && d.get("netman", null) != null));
    }
    // The derby a catch was entered in (if any), and whether I organise it.
    function derbyOf(c) { return get(derbyPath(c.derbyId)).data; }
    function isOrganiserOf(c) { return c.get("derbyId", null) != null && exists(derbyPath(c.derbyId)) && derbyOf(c).organiserUid == me(); }
    // A testing derby's organiser can clear out everything entered in it.
    function testingOrganiserOf(c) { return isOrganiserOf(c) && derbyOf(c).get("testing", false) == true; }
    // A catch is written by its angler, or by a derby's organiser entering it for an angler (enteredBy = organiser).
    function writesFor(d) {
      return (d.uid == me() && d.get("enteredBy", null) == null)
        || (d.get("enteredBy", null) == me() && d.uid != me() && isOrganiserOf(d) && exists(memberPath(d.uid)));
    }
    function sameDq(a, b) { return a.get("dq", false) == b.get("dq", false) && a.get("dqReason", "") == b.get("dqReason", ""); }
    // Derbies with approval on: an entry counts once the organiser approves it. Only the organiser (or an admin) can
    // approve, so an angler's own save is never approved, except one the organiser makes (their own entry or one they
    // entered for an angler). Changing what was approved (the fish, the photo, the time, the derby) takes the approval away.
    function proofChanged() { return changed().hasAny(["species", "weightOz", "lengthIn", "caughtAt", "thumb", "photoTakenAt", "derbyId", "fishCount"]); }
    function approvalOk(d, old) {
      return d.get("approved", false) == false
        || isOrganiserOf(d)
        || (old != null && old.get("approved", false) == true && d.get("approvedAt", null) == old.get("approvedAt", null) && !proofChanged());
    }
    match /catches/{id} {
      allow read: if isMember();
      // Weight and length are optional, but every catch needs its photo as proof (saved in the same batch).
      allow create: if isMember() && validCatch(request.resource.data) && writesFor(request.resource.data)
        && pastOk(request.resource.data, false)
        && approvalOk(request.resource.data, null)
        && existsAfter(/databases/$(database)/documents/photos/$(id))
        && request.resource.data.get("dq", false) == false
        && !request.resource.data.keys().hasAny(["dqReason"]);
      // The angler can edit their catch, but can't touch a disqualification, and a derby entry is locked once
      // that derby's final entries have closed.
      // An organiser who entered a catch for an angler can edit it too. A deleted derby no longer locks its old entries.
      allow update: if (isMember()
          && (resource.data.uid == me() || (resource.data.get("enteredBy", null) == me() && isOrganiserOf(resource.data)))
          && validCatch(request.resource.data)
          && pastOk(request.resource.data, resource.data.get("past", false))
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.get("enteredBy", null) == resource.data.get("enteredBy", null)
          && request.resource.data.createdAt == resource.data.createdAt
          && sameDq(request.resource.data, resource.data)
          && approvalOk(request.resource.data, resource.data)
          && (resource.data.get("derbyId", null) == null || !exists(derbyPath(resource.data.derbyId))
              || derbyOpen(get(derbyPath(resource.data.derbyId)).data)))
        // The derby's organiser (or an admin) can disqualify, reinstate or approve an entry, and change nothing else.
        || (isMember() && resource.data.get("derbyId", null) != null
            && (get(derbyPath(resource.data.derbyId)).data.organiserUid == me() || isAdmin())
            && changed().hasOnly(["dq", "dqReason", "approved", "approvedAt"])
            && request.resource.data.get("approved", false) is bool
            && (request.resource.data.get("approvedAt", null) == null || request.resource.data.approvedAt is number)
            && request.resource.data.get("dq", false) is bool
            && request.resource.data.get("dqReason", "") is string && request.resource.data.get("dqReason", "").size() <= 200);
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin()
        || resource.data.get("enteredBy", null) == me() || testingOrganiserOf(resource.data));

      // The catch's angler (or a testing derby's organiser clearing it out) can remove its comments and reactions.
      function catchOwner() { let c = get(catchPath(id)).data; return c.uid == me() || testingOrganiserOf(c); }

      // Comments: anyone in the league, as themselves. The author, the catch's angler or an admin can remove one.
      match /comments/{cid} {
        allow create: if isMember() && exists(catchPath(id))
          && request.resource.data.keys().hasOnly(["uid", "text", "at", "mentions"]) && validMentions(request.resource.data)
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 600000;
        allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || catchOwner());
      }

      // Emoji reactions: one doc per person per catch, named by their user id, so nobody can change anyone else's.
      match /reactions/{rid} {
        allow create, update: if isMember() && rid == me() && exists(catchPath(id))
          && request.resource.data.keys().hasOnly(["uid", "emojis", "at"])
          && request.resource.data.uid == me()
          && request.resource.data.emojis is list && request.resource.data.emojis.size() > 0 && request.resource.data.emojis.size() <= 8
          && request.resource.data.at is number;
        allow delete: if isMember() && (rid == me() || isAdmin() || catchOwner());
      }
    }

    // Reading comments and reactions across all catches at once (the app keeps them all, like the catches).
    match /{path=**}/comments/{cid} { allow read: if isMember(); }
    match /{path=**}/reactions/{rid} { allow read: if isMember(); }

    // @mentions saved with a chat message or comment: the ids of the members it mentions.
    function validMentions(d) { return !("mentions" in d) || (d.mentions is list && d.mentions.size() <= 20); }

    // League chat.
    match /chat/{mid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(["uid", "text", "at", "mentions"]) && validMentions(request.resource.data)
        && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 600000;
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin());
    }

    // The full-size photo of a catch, in its own doc so lists only load thumbnails. Same id as the catch.
    match /photos/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && request.resource.data.keys().hasOnly(["uid", "src", "bytes"])
        && request.resource.data.uid == me() && request.resource.data.src is string
        && request.resource.data.src.size() < 700000
        // The photo's size, saved for the storage meter (older photos don't have it).
        && (!("bytes" in request.resource.data) || request.resource.data.bytes == request.resource.data.src.size())
        && (getAfter(catchPath(id)).data.uid == me() || getAfter(catchPath(id)).data.get("enteredBy", null) == me());
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || testingOrganiserOf(get(catchPath(id)).data));
    }

    // GPS spot of a catch. Kept out of the catch so a private spot is only ever readable by its owner.
    match /spots/{id} {
      allow read: if isMember() && (resource.data.shared == true || resource.data.uid == me());
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(["uid", "lat", "lng", "acc", "name", "shared"])
        && request.resource.data.uid == me()
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.acc is number
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.shared is bool
        // Must match its catch, so the catch never says "shared" while the spot is private or the other way round.
        // A spot an organiser tags for someone else's entry must be shared, so the angler can see it too.
        && (getAfter(catchPath(id)).data.uid == me()
            || (getAfter(catchPath(id)).data.get("enteredBy", null) == me() && request.resource.data.shared == true))
        && getAfter(catchPath(id)).data.locShared == request.resource.data.shared;
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || testingOrganiserOf(get(catchPath(id)).data));
    }

    // Tackle on a catch (bait or lure, depth, technique), kept like a spot: shared tackle is read by everyone, secret
    // tackle only by the angler. It must agree with its catch, and goes when the catch goes.
    match /tackle/{id} {
      allow read: if isMember() && (resource.data.shared == true || resource.data.uid == me());
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(["uid", "lure", "depthFt", "technique", "shared"])
        && request.resource.data.uid == me()
        && request.resource.data.lure is string && request.resource.data.lure.size() <= 60
        && (request.resource.data.depthFt == null
            || (request.resource.data.depthFt is number && request.resource.data.depthFt > 0 && request.resource.data.depthFt <= 1000))
        && request.resource.data.technique in ["", "casting", "trolling", "jigging", "livebait", "fly", "ice", "drift", "bottom"]
        && request.resource.data.shared is bool
        // Tackle an organiser adds to someone else's entry must be shared, so the angler can see it too.
        && (getAfter(catchPath(id)).data.uid == me()
            || (getAfter(catchPath(id)).data.get("enteredBy", null) == me() && request.resource.data.shared == true))
        && getAfter(catchPath(id)).data.get("hasTackle", false) == true
        && getAfter(catchPath(id)).data.get("tackleShared", false) == request.resource.data.shared;
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || get(catchPath(id)).data.uid == me()
        || get(catchPath(id)).data.get("enteredBy", null) == me() || testingOrganiserOf(get(catchPath(id)).data));
    }

    // Skunks: a day out with no fish, logged by the angler. One per angler per day: the id is "{uid}_{YYYY-MM-DD}".
    function validSkunk(sid, d) {
      return d.keys().hasOnly(["uid", "day", "notes", "createdAt"])
        && d.uid == me()
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && sid == me() + "_" + d.day
        && d.notes is string && d.notes.size() <= 200
        && d.createdAt is number;
    }
    match /skunks/{sid} {
      allow read: if isMember();
      allow create: if isMember() && validSkunk(sid, request.resource.data);
      allow update: if isMember() && resource.data.uid == me() && validSkunk(sid, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin());
    }

    // ---------- Derbies ----------
    function validDerby(d) {
      return d.keys().hasOnly(["name", "description", "organiserUid", "start", "end", "syncGraceHours", "species", "scoring",
                               "bagSize", "minWeightOz", "minLengthIn", "maxEntries", "proof", "requireLocation", "catchRelease",
                               "requireCrew", "prizeNote", "cancelled", "createdAt",
                               "entryFee", "addedMoney", "payoutPcts", "unpaidCanWin", "captainPct", "netmanPct", "roundTo", "sidePotFee",
                               "testing", "mystery", "mysteryNote", "categories", "mysteryPct", "teams", "teamScoring", "seriesId",
                               "codeWord", "approval"])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.description is string && d.description.size() <= 500
        && d.start is number && d.end is number && d.end > d.start
        && d.syncGraceHours is number && d.syncGraceHours >= 0 && d.syncGraceHours <= 168
        && d.species is list && d.species.size() <= 40
        && d.scoring in ["heaviest", "longest", "bag", "most", "species"]
        && d.bagSize is number && d.bagSize >= 1 && d.bagSize <= 20
        && d.minWeightOz is number && d.minWeightOz >= 0 && d.minLengthIn is number && d.minLengthIn >= 0
        && d.maxEntries is number && d.maxEntries >= 0 && d.maxEntries <= 100
        && d.proof in ["any", "scale", "board", "both"]
        && d.requireLocation is bool && d.catchRelease is bool && d.requireCrew is bool
        && d.prizeNote is string && d.prizeNote.size() <= 300
        && d.cancelled is bool && d.createdAt is number
        && d.get("testing", false) is bool
        && d.get("mystery", false) is bool && d.get("mysteryNote", "") is string && d.get("mysteryNote", "").size() <= 100
        // Categories (several boards in one derby): the app checks each one; here, at most 6, and the mystery's share.
        && d.get("categories", []) is list && d.get("categories", []).size() <= 6
        && d.get("mysteryPct", 0) is number && d.get("mysteryPct", 0) >= 0 && d.get("mysteryPct", 0) <= 100
        // Team derbies: the organiser names up to 12 teams.
        && d.get("teams", []) is list && d.get("teams", []).size() <= 12
        && d.get("teamScoring", "sum") in ["sum", "boat"]
        // The season series it counts toward ("" for none).
        && d.get("seriesId", "") is string && d.get("seriesId", "").size() <= 40
        // Fair play: a photo code word ("" for none) and whether entries need the organiser's approval.
        && d.get("codeWord", "") is string && d.get("codeWord", "").size() <= 20
        && d.get("approval", false) is bool
        && validMoney(d);
    }
    // Entry fees and payouts (the app only keeps track; nobody pays through it). Older derbies have none of these.
    function money(d, f) { return d.get(f, 0); }
    function validMoney(d) {
      return money(d, "entryFee") is number && money(d, "entryFee") >= 0 && money(d, "entryFee") <= 10000
        && money(d, "addedMoney") is number && money(d, "addedMoney") >= 0 && money(d, "addedMoney") <= 100000
        && money(d, "sidePotFee") is number && money(d, "sidePotFee") >= 0 && money(d, "sidePotFee") <= 10000
        && money(d, "captainPct") is number && money(d, "captainPct") >= 0 && money(d, "captainPct") <= 50
        && money(d, "netmanPct") is number && money(d, "netmanPct") >= 0 && money(d, "netmanPct") <= 50
        && money(d, "roundTo") in [0, 1, 5]
        && d.get("payoutPcts", []) is list && d.get("payoutPcts", []).size() <= 10
        && d.get("unpaidCanWin", false) is bool;
    }
    function validTeam(e) { return e.get("team", "") is string && e.get("team", "").size() <= 40; }
    match /derbies/{did} {
      allow read: if isMember();
      allow create: if isMember() && validDerby(request.resource.data) && request.resource.data.organiserUid == me()
        && request.resource.data.cancelled == false;
      // The organiser or an admin can change it (cancel it, or end it early). Only the league owner can change
      // whether it's a testing derby, so a real derby can't be turned into a deletable one.
      allow update: if isMember() && (resource.data.organiserUid == me() || isAdmin())
        && validDerby(request.resource.data) && !changed().hasAny(["organiserUid", "createdAt"])
        && (!changed().hasAny(["testing"]) || isOwner());
      // Deleting: the league owner, any derby; its organiser, only a testing derby. Real results otherwise stay.
      allow delete: if isMember() && (isOwner() || (resource.data.organiserUid == me() && resource.data.get("testing", false) == true));

      // Joining: yourself, until the derby ends (picking a team in a team derby). Leaving: yourself, or removed by
      // the organiser or an admin. You can switch teams until the derby starts; the organiser or an admin any time.
      match /entrants/{who} {
        allow create: if isMember() && who == me() && request.resource.data.keys().hasOnly(["joinedAt", "team"])
          && request.resource.data.joinedAt is number && validTeam(request.resource.data)
          && !get(derbyPath(did)).data.cancelled && request.time.toMillis() <= get(derbyPath(did)).data.end;
        allow delete: if isMember() && (who == me() || get(derbyPath(did)).data.organiserUid == me() || isAdmin());
        // Paid ticks and team moves: only the organiser or an admin, and nothing else about the entrant.
        allow update: if isMember() && (get(derbyPath(did)).data.organiserUid == me() || isAdmin())
          && changed().hasOnly(["paid", "paidAt", "paidMarkedBy", "sidePotPaid", "team"])
          && request.resource.data.get("paid", false) is bool && request.resource.data.get("sidePotPaid", false) is bool
          && (!changed().hasAny(["paidMarkedBy"]) || request.resource.data.paidMarkedBy == me())
          && validTeam(request.resource.data);
        // Your own team: picking one any time, switching only before the derby starts.
        allow update: if isMember() && who == me() && changed().hasOnly(["team"]) && validTeam(request.resource.data)
          && (resource.data.get("team", "") == "" || request.time.toMillis() < get(derbyPath(did)).data.start);
      }

      // "Paid out" ticks for each payee once the organiser has settled up.
      match /settlements/{key} {
        allow read: if isMember();
        allow create, update: if isMember() && (get(derbyPath(did)).data.organiserUid == me() || isAdmin())
          && request.resource.data.keys().hasOnly(["amount", "settledAt", "by"])
          && request.resource.data.amount is number && request.resource.data.settledAt is number
          && request.resource.data.by == me();
        allow delete: if isMember() && (get(derbyPath(did)).data.organiserUid == me() || isAdmin());
      }

      // The mystery weight. Only the organiser (or an admin) can see it until final entries close; then everyone can.
      // It can be set any time but only changed or removed before the derby starts, so nobody moves it to suit a fish.
      // Deleting the derby (league owner, or a test derby's organiser) clears it too.
      match /secret/{key} {
        allow read: if isMember() && (get(derbyPath(did)).data.organiserUid == me() || isAdmin()
          || request.time.toMillis() > get(derbyPath(did)).data.end + get(derbyPath(did)).data.syncGraceHours * 3600000);
        allow create, update: if isMember() && key == "mystery" && (get(derbyPath(did)).data.organiserUid == me() || isAdmin())
          && (resource == null || request.time.toMillis() < get(derbyPath(did)).data.start)
          && request.resource.data.keys().hasOnly(["weightOz", "setBy", "setAt"])
          && request.resource.data.weightOz is number && request.resource.data.weightOz > 0 && request.resource.data.weightOz <= 2000
          && request.resource.data.setBy == me() && request.resource.data.setAt is number;
        allow delete: if isMember() && (isOwner()
          || ((get(derbyPath(did)).data.organiserUid == me() || isAdmin()) && request.time.toMillis() < get(derbyPath(did)).data.start)
          || (get(derbyPath(did)).data.organiserUid == me() && get(derbyPath(did)).data.get("testing", false) == true));
      }

      // Derby chat (trash talk for this derby).
      match /chat/{mid} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(["uid", "text", "at", "mentions"]) && validMentions(request.resource.data)
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 600000;
        allow delete: if isMember() && (resource.data.uid == me() || isAdmin() || get(derbyPath(did)).data.organiserUid == me());
      }
    }
    match /{path=**}/entrants/{who} { allow read: if isMember(); }

    // ---------- Trips (called Outings in the app) ----------
    // "Who's out Saturday?": anyone can plan one; its planner (or an admin) can change or delete it.
    // Each member answers In / Maybe / Out in their own doc, and on a boat outing can take a seat on a boat.
    function tripPath(id) { return /databases/$(database)/documents/trips/$(id); }
    function validTrip(t) {
      return t.keys().hasOnly(["uid", "title", "at", "place", "notes", "createdAt", "kind", "endAt"])
        && t.uid is string
        && t.title is string && t.title.size() > 0 && t.title.size() <= 60
        && t.at is number && t.place is string && t.place.size() <= 60
        && t.notes is string && t.notes.size() <= 500 && t.createdAt is number
        && t.get("kind", "shore") in ["boat", "shore"]
        && (t.get("endAt", null) == null || (t.endAt is number && t.endAt > t.at));
    }
    // An answer, and on a boat outing the boat (its owner's uid) you're sitting in and when you took the seat.
    function validRsvp(r) {
      return r.keys().hasOnly(["answer", "at", "boat", "seatAt"])
        && r.answer in ["in", "maybe", "out"] && r.at is number
        && r.get("boat", "") is string && r.get("boat", "").size() <= 128 && r.get("seatAt", 0) is number
        && (r.get("boat", "") == "" || r.answer == "in");
    }
    match /trips/{tid} {
      allow read: if isMember();
      allow create: if isMember() && validTrip(request.resource.data) && request.resource.data.uid == me();
      allow update: if isMember() && (resource.data.uid == me() || isAdmin()) && validTrip(request.resource.data)
        && request.resource.data.uid == resource.data.uid && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMember() && (resource.data.uid == me() || isAdmin());
      match /rsvps/{who} {
        allow read: if isMember();
        allow create, update: if isMember() && who == me() && exists(tripPath(tid))
          && validRsvp(request.resource.data);
        // Yourself, or the trip's planner or an admin clearing out a deleted trip.
        allow delete: if isMember() && (who == me() || isAdmin() || !exists(tripPath(tid)) || get(tripPath(tid)).data.uid == me());
      }
      // Boats: anyone can offer theirs (spare seats, not counting the owner); only the owner changes it. The owner,
      // the outing's planner or an admin can take it off (or anyone, once the outing is deleted).
      match /boats/{owner} {
        allow read: if isMember();
        allow create, update: if isMember() && owner == me() && exists(tripPath(tid))
          && request.resource.data.keys().hasOnly(["seats", "name", "at"])
          && request.resource.data.seats is int && request.resource.data.seats >= 1 && request.resource.data.seats <= 12
          && request.resource.data.name is string && request.resource.data.name.size() <= 40 && request.resource.data.at is number;
        allow delete: if isMember() && (owner == me() || isAdmin() || !exists(tripPath(tid)) || get(tripPath(tid)).data.uid == me());
      }
    }
    match /{path=**}/rsvps/{who} { allow read: if isMember(); }
    match /{path=**}/boats/{owner} { allow read: if isMember(); }

    // ---------- Season series (Angler of the Year) ----------
    // League admins set them up; derby organisers put their derby in one (the derby's seriesId).
    function validSeries(x) {
      return x.keys().hasOnly(["name", "start", "end", "points", "showUpPts", "bestOf", "createdBy", "createdAt"])
        && x.name is string && x.name.size() > 0 && x.name.size() <= 60
        && x.start is number && x.end is number && x.end > x.start
        && x.points is list && x.points.size() > 0 && x.points.size() <= 20
        && x.showUpPts is number && x.showUpPts >= 0 && x.showUpPts <= 100
        && x.bestOf is number && x.bestOf >= 0 && x.bestOf <= 50
        && x.createdBy is string && x.createdAt is number;
    }
    match /series/{sid} {
      allow read: if isMember();
      allow create: if isAdmin() && validSeries(request.resource.data) && request.resource.data.createdBy == me();
      allow update: if isAdmin() && validSeries(request.resource.data) && !changed().hasAny(["createdBy", "createdAt"]);
      allow delete: if isAdmin();
    }

    // ---------- Head-to-head challenges ----------
    // One angler challenges another. The one whose turn it is accepts, declines or counters (new terms, and it's the
    // other one's turn), all before it starts; the other one can withdraw their offer. Once accepted, the terms are
    // fixed and the catches decide it. Points are worked out by the app (the max stake and "only what you have" are
    // checked there); here, the shape. The league owner can veto a result, which voids it.
    function validTerms(t) {
      return t is map && t.keys().hasOnly(["win", "bagSize", "species", "start", "end", "stake", "money", "note"])
        && t.win in ["heaviest", "longest", "most", "bag"]
        && t.bagSize is int && t.bagSize >= 1 && t.bagSize <= 10
        && t.species is list && t.species.size() <= 10
        && t.start is number && t.end is number && t.end > t.start && t.end - t.start <= 31 * 86400000
        && t.stake is int && t.stake >= 0 && t.stake <= 1000
        && t.money is string && t.money.size() <= 100
        && t.note is string && t.note.size() <= 200;
    }
    function startsLater(t) { return t.start > request.time.toMillis(); }
    match /challenges/{cid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(["from", "to", "terms", "status", "turn", "counters", "createdAt", "updatedAt", "vetoed"])
        && request.resource.data.from == me() && request.resource.data.to != me() && exists(memberPath(request.resource.data.to))
        && request.resource.data.status == "open" && request.resource.data.turn == request.resource.data.to
        && request.resource.data.counters == 0 && request.resource.data.vetoed == false
        && validTerms(request.resource.data.terms) && startsLater(request.resource.data.terms)
        && request.resource.data.createdAt is number && request.resource.data.updatedAt is number;
      allow update: if isMember() && (
        // Your turn, before it starts: accept or decline as offered, or counter with new terms.
        (resource.data.status == "open" && resource.data.turn == me() && startsLater(resource.data.terms)
          && request.resource.data.updatedAt is number
          && ((changed().hasOnly(["status", "acceptedAt", "updatedAt"]) && request.resource.data.status == "accepted"
               && request.resource.data.acceptedAt is number)
            || (changed().hasOnly(["status", "updatedAt"]) && request.resource.data.status == "declined")
            || (changed().hasOnly(["terms", "turn", "counters", "updatedAt"])
               && validTerms(request.resource.data.terms) && startsLater(request.resource.data.terms)
               && request.resource.data.turn in [resource.data.from, resource.data.to] && request.resource.data.turn != me()
               && request.resource.data.counters == resource.data.counters + 1 && request.resource.data.counters <= 20)))
        // Waiting on the other one: take your offer back.
        || (resource.data.status == "open" && resource.data.turn != me() && me() in [resource.data.from, resource.data.to]
          && changed().hasOnly(["status", "updatedAt"]) && request.resource.data.status == "withdrawn"
          && request.resource.data.updatedAt is number)
        // The league owner vetoes a result (or takes the veto back).
        || (isOwner() && changed().hasOnly(["vetoed", "vetoedAt", "vetoedBy"]) && request.resource.data.vetoed is bool
          && request.resource.data.vetoedAt is number && request.resource.data.vetoedBy == me()));
      allow delete: if isOwner();
    }

    // ---------- Bets ----------
    // Any member starts one and organises it. Never league points: a buy-in in dollars and/or a prize in words, which the
    // app only keeps track of. The organiser can change it until it starts and cancel it any time. Players join
    // themselves until it starts: anyone when it's open, otherwise the organiser and the anglers invited.
    function betPath(id) { return /databases/$(database)/documents/bets/$(id); }
    function validBet(b) {
      return b.keys().hasOnly(["title", "organiserUid", "kind", "rule", "sides", "open", "invited", "start", "end", "buyIn", "roundTo", "prize", "note", "createdAt", "cancelled", "result"])
        && b.title is string && b.title.size() > 0 && b.title.size() <= 80
        && b.organiserUid is string && b.kind in ["contest", "sides"]
        && b.rule is map && b.rule.keys().hasOnly(["win", "species", "minWeightOz", "minLengthIn", "subject", "measure", "line"])
        // Contests: how it's won. Sides: over/under on catches, or the organiser's call, between 2 to 6 named sides.
        && (b.kind == "contest" ? b.rule.win in ["heaviest", "longest", "most", "first", "called"] && b.get("sides", []).size() == 0
          : b.rule.win in ["over", "called"] && b.sides is list && b.sides.size() >= 2 && b.sides.size() <= 6)
        && (b.rule.win != "over" || (b.rule.subject is string && b.rule.subject.size() > 0 && b.rule.subject.size() <= 40
          && b.rule.measure in ["fish", "weight", "length"] && b.rule.line is number && b.rule.line > 0))
        && b.rule.species is list && b.rule.species.size() <= 10
        && b.rule.minWeightOz is number && b.rule.minWeightOz >= 0 && b.rule.minLengthIn is number && b.rule.minLengthIn >= 0
        && b.open is bool && b.invited is list && b.invited.size() <= 50
        && b.start is number && b.end is number && b.end > b.start && b.end - b.start <= 366 * 86400000
        && b.buyIn is number && b.buyIn >= 0 && b.buyIn <= 10000 && b.roundTo in [0, 1, 5]
        && b.prize is string && b.prize.size() <= 200 && b.note is string && b.note.size() <= 300
        && b.createdAt is number && b.cancelled is bool
        && (!("result" in b) || validBetResult(b.result));
    }
    // The organiser's call on a bet they settle: who won (several split it), or a wash.
    function validBetResult(r) {
      return r is map && r.keys().hasOnly(["winners", "wash", "at", "by", "side"]) && r.winners is list && r.winners.size() <= 50
        && r.wash is bool && r.at is number && r.by == me() && (!("side" in r) || r.side is int);
    }
    function startedBet(bid) { return request.time.toMillis() >= get(betPath(bid)).data.start; }
    match /bets/{bid} {
      allow read: if isMember();
      allow create: if isMember() && validBet(request.resource.data) && request.resource.data.organiserUid == me()
        && request.resource.data.cancelled == false && request.resource.data.start > request.time.toMillis()
        && !("result" in request.resource.data);
      // Before it starts: change anything (it can't be moved to start in the past). After: only cancel or un-cancel.
      allow update: if isMember() && resource.data.organiserUid == me() && validBet(request.resource.data)
        && !changed().hasAny(["organiserUid", "createdAt", "kind"])
        && ((request.time.toMillis() < resource.data.start && request.resource.data.start > request.time.toMillis() && !("result" in request.resource.data))
          || changed().hasOnly(["cancelled"])
          || settling());
      // Once it has started, the organiser settles a bet they decide (or changes their call); the league owner can too.
      function settling() {
        return changed().hasOnly(["result"]) && resource.data.rule.win == "called" && request.time.toMillis() >= resource.data.start;
      }
      allow update: if isOwner() && validBet(request.resource.data) && settling();
      allow delete: if isOwner() || (isMember() && resource.data.organiserUid == me() && request.time.toMillis() < resource.data.start);
      match /players/{who} {
        allow read: if isMember();
        // Yourself, before it starts, if you can join: in, or turning an invite down (in: false). On a sides bet, the side
        // you're on (switch any time before it starts).
        allow create, update: if isMember() && who == me() && exists(betPath(bid))
          && request.resource.data.keys().hasOnly(["at", "in", "side"]) && request.resource.data.at is number && request.resource.data.in is bool
          && (get(betPath(bid)).data.kind != "sides" ? !("side" in request.resource.data)
            : !request.resource.data.in || (request.resource.data.get("side", -1) is int && request.resource.data.get("side", -1) >= 0
              && request.resource.data.get("side", -1) < get(betPath(bid)).data.sides.size()))
          && !get(betPath(bid)).data.cancelled && request.time.toMillis() < get(betPath(bid)).data.start
          && (get(betPath(bid)).data.open || get(betPath(bid)).data.organiserUid == me() || me() in get(betPath(bid)).data.invited);
        // Leaving before it starts; the organiser can take someone off before it starts; anyone once the bet is gone.
        allow delete: if isMember() && (!exists(betPath(bid))
          || (request.time.toMillis() < get(betPath(bid)).data.start && (who == me() || get(betPath(bid)).data.organiserUid == me()))
          || isOwner());
      }
      // Proof for a bet the organiser decides: one photo and a note per angler in it, sent once it has started and
      // until it's settled (they can replace it). Removed by its angler, the organiser or the league owner.
      match /proofs/{who} {
        allow read: if isMember();
        allow create, update: if isMember() && who == me() && exists(betPath(bid))
          && get(betPath(bid)).data.rule.win == "called" && !get(betPath(bid)).data.cancelled && startedBet(bid)
          && !("result" in get(betPath(bid)).data)
          && get(/databases/$(database)/documents/bets/$(bid)/players/$(me())).data.get("in", false) == true
          && request.resource.data.keys().hasOnly(["photo", "thumb", "takenAt", "note", "at"])
          && request.resource.data.photo is string && request.resource.data.photo.size() > 100 && request.resource.data.photo.size() < 400000
          && request.resource.data.thumb is string && request.resource.data.thumb.size() > 100 && request.resource.data.thumb.size() < 60000
          && (request.resource.data.takenAt == null || request.resource.data.takenAt is number)
          && request.resource.data.note is string && request.resource.data.note.size() <= 200 && request.resource.data.at is number;
        allow delete: if isMember() && (who == me() || isOwner() || !exists(betPath(bid)) || get(betPath(bid)).data.organiserUid == me());
      }
    }
    match /{path=**}/players/{who} { allow read: if isMember(); }

    // ---------- Ranking points ----------
    // Each change to the scoring values is a new version; old versions are never edited or deleted, so the
    // history of how points worked can't be rewritten. Points themselves are never stored.
    function pts(n) { return n is number && n >= 0 && n <= 1000; }
    function validScoring(v) {
      return v.keys().hasOnly(["catchPts", "dailyCap", "limitPts", "speciesPts", "recordPts", "crownPts", "badgePts", "derbyPts", "participationPts", "beatPts", "titles",
                              "h2hPts", "h2hWinPts", "h2hMaxStake"])
        && (!("h2hPts" in v) || pts(v.h2hPts)) && (!("h2hWinPts" in v) || pts(v.h2hWinPts)) && (!("h2hMaxStake" in v) || pts(v.h2hMaxStake))
        && (!("limitPts" in v) || pts(v.limitPts)) && (!("crownPts" in v) || pts(v.crownPts)) && (!("badgePts" in v) || pts(v.badgePts))
        && pts(v.catchPts) && pts(v.dailyCap) && pts(v.speciesPts) && pts(v.participationPts) && pts(v.beatPts)
        && v.recordPts is list && v.recordPts.size() == 3
        && v.derbyPts is list && v.derbyPts.size() == 3
        && v.titles is list && v.titles.size() == 7;
    }
    match /scoring/{vid} {
      allow read: if isMember();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["mode", "effectiveFrom", "createdAt", "createdBy", "note", "values"])
        && request.resource.data.mode in ["retro", "forward"]
        && request.resource.data.effectiveFrom is number && request.resource.data.createdAt is number
        && request.resource.data.createdBy == me()
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && validScoring(request.resource.data.values);
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
